# =============================================================================
# FMRJ - Variaveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# NUNCA commite o .env.local. A service role key e SECRETA (somente servidor).
# =============================================================================

# URL do projeto Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica "anon" (Project Settings > API > anon public)
# Seguro expor no browser; a seguranca vem das policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave "service role" (Project Settings > API > service_role)
# SECRETA. Bypassa RLS. Use SOMENTE em codigo de servidor (server actions,
# route handlers, scripts de seed). NUNCA prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL publica do site (usada em metadata/Open Graph/SEO).
# Em producao, a URL do deploy (ex.: https://fmrj.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
